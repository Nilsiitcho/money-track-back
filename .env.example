# ===== Banco de dados (PostgreSQL) =====
POSTGRES_DB=moneytrack
POSTGRES_USER=moneytrack
POSTGRES_PASSWORD=moneytrack
POSTGRES_PORT=5432

# ===== Backend =====
BACKEND_PORT=8080

# Segredo do JWT. Troque por valor aleatorio longo (>= 32 bytes).
# Gere com: openssl rand -base64 48
APP_JWT_SECRET=change-me-please-use-a-long-random-secret-at-least-32-bytes
APP_JWT_EXPIRATION_HOURS=168

# Usuario unico (semente). Senha e aplicada/atualizada no startup.
APP_SEED_USER=admin
APP_SEED_PASSWORD=changeme

# Origens permitidas para CORS (separadas por virgula)
APP_CORS_ORIGINS=http://localhost:5173

# ===== Frontend =====
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
